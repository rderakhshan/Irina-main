# Irina environment example.
# Copy to .env and replace the placeholder paths and key.
# .env is ignored by Git; this example file is safe to commit.

# --- Model ---
DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Additional providers ---
# Leave a provider key empty to exclude it from automatic routing.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional provider endpoints (leave empty for the public defaults).
OPENAI_BASE_URL=
GEMINI_BASE_URL=

# --- Model selection ---
# auto    = Laya chooses from enabled models with credentials
# default = use IRINA_DEFAULT_PROVIDER / IRINA_DEFAULT_MODEL without Laya
# manual  = use --provider and --model (or the provider name here)
IRINA_PROVIDER=auto
IRINA_DEFAULT_PROVIDER=deepseek
IRINA_DEFAULT_MODEL=
IRINA_FALLBACK_PROVIDER=deepseek
IRINA_FALLBACK_MODEL=

# Provider-specific default model IDs. Empty uses the adapter defaults.
DEEPSEEK_MODEL=
OPENAI_MODEL=
GEMINI_MODEL=

# Optional catalog override. JSON list (or {"models": [...]}) with entries:
# {"id": "...", "provider": "openai", "api_model": "...", "enabled": true,
#  "supports_tools": true, "supports_streaming": true, "description": "..."}
# IRINA_MODEL_CATALOG=

# --- Laya CPU routing ---
# Laya runs on the trusted host, on CPU. The first prediction downloads the
# routed checkpoint into the Hugging Face cache; later runs reuse it.
IRINA_LAYA_ENABLED=true
IRINA_LAYA_DEVICE=cpu
IRINA_LAYA_TIMEOUT_SECONDS=10

# --- Sandbox / skills ---
IRINA_SANDBOX_IMAGE=irina/irina-tools:1
# Opt-in network access for web tools. Comment this line out to restore the
# strict no-network default policy.
IRINA_SANDBOX_POLICY=src/back/harness/tools_and_guardrails/openshell_policy_network.yaml
IRINA_SKILLS_DIR=skills

# --- Application inputs ---
# Use an absolute host path. This example masks the machine-specific folder.
IRINA_INPUTS=C:\path\to\Application\input\resume.tex
# Optional inputs are uploaded only when they exist.
IRINA_OPTIONAL_INPUTS=C:\path\to\Application\reference.pdf;C:\path\to\Application\examples

# --- Artifact export ---
IRINA_EXPORT_PATHS=application
IRINA_EXPORT_CONTENTS=1
IRINA_ARTIFACTS_DIR=C:\path\to\Application
IRINA_AUTO_EXPORT=1
IRINA_FORCE_EXPORT=0

# --- Runtime ---
IRINA_MODE=safe
# Disable all application defaults when the CV is absent.
IRINA_DEFAULTS_REQUIRE=C:\path\to\Application\input\resume.tex

# --- Memory (opt-in) ---
# IRINA_MEMORY_ENABLED=1
# IRINA_MEMORY_PROVIDER=lightweight_memory
# IRINA_MEMORY_STATE_DIR=C:\path\to\memory

# --- Evolution (optional, OpenAI-compatible endpoint) ---
# The memory evolution bridge uses OPENAI_API_KEY and OPENAI_BASE_URL above.
# OPENAI_BASE_URL=https://api.deepseek.com
